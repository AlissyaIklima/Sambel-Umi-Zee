{
  "version": 2,
  "framework": null,
  "buildCommand": "vite build",
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    { "src": "/build/(.*)", "dest": "/build/$1" },
    { "src": "/images/(.*)", "dest": "/images/$1" },
    { "src": "/storage/(.*)", "dest": "/storage/$1" },
    { "src": "/favicon.ico", "dest": "/favicon.ico" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}